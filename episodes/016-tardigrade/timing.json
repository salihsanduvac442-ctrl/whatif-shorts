[
 {
  "text": "What if you were as tough as a tardigrade?",
  "start": 0.0,
  "end": 1.5345833333333334
 },
 {
  "text": "Meet the water bear. Half a millimeter.",
  "start": 1.6145833333333335,
  "end": 2.965791666666667
 },
 {
  "text": "Eight chubby legs. Lives in wet moss.",
  "start": 3.045791666666667,
  "end": 4.674333333333334
 },
 {
  "text": "Dried out, it shrivels into a ball.",
  "start": 4.754333333333334,
  "end": 6.146833333333334
 },
 {
  "text": "Frozen for thirty years? It woke up!",
  "start": 6.226833333333334,
  "end": 7.644208333333334
 },
 {
  "text": "Chilled near absolute zero. Fine.",
  "start": 7.724208333333334,
  "end": 9.204
 },
 {
  "text": "Heated to 150 degrees? Still fine.",
  "start": 9.284,
  "end": 11.176583333333333
 },
 {
  "text": "Squeezed harder than the deepest ocean.",
  "start": 11.256583333333333,
  "end": 12.647958333333333
 },
 {
  "text": "Ten days in open space. Many survived!",
  "start": 12.727958333333333,
  "end": 14.704041666666667
 },
 {
  "text": "Radiation? About 1,000 times your limit.",
  "start": 14.784041666666667,
  "end": 16.756916666666665
 },
 {
  "text": "A special protein shields its DNA.",
  "start": 16.836916666666667,
  "end": 18.250625
 },
 {
  "text": "Normal you in a blizzard? Brrr.",
  "start": 18.330625,
  "end": 19.969416666666667
 },
 {
  "text": "Now switch on tardigrade power!",
  "start": 20.04941666666667,
  "end": 21.28241666666667
 },
 {
  "text": "Frozen in ice? Pop out smiling!",
  "start": 21.362416666666668,
  "end": 22.91325
 },
 {
  "text": "Bottom of the ocean? No problem!",
  "start": 22.993250000000003,
  "end": 24.343375
 },
 {
  "text": "The catch? You'd have to dry up first.",
  "start": 24.423375000000004,
  "end": 25.804125000000003
 },
 {
  "text": "So... where would you go first?",
  "start": 25.884125000000004,
  "end": 27.021083333333337
 }
]