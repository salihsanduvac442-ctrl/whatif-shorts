[
 {
  "text": "What if you tried to lift a million dollars?",
  "start": 0.0,
  "end": 1.5176666666666667
 },
 {
  "text": "Start with one hundred-dollar bill. One gram.",
  "start": 1.5976666666666668,
  "end": 3.5000833333333334
 },
 {
  "text": "Ten thousand of them make a million.",
  "start": 3.5800833333333335,
  "end": 4.918041666666667
 },
 {
  "text": "That's just ten kilos. Like a big watermelon.",
  "start": 4.998041666666667,
  "end": 7.009166666666667
 },
 {
  "text": "It fits in one big briefcase.",
  "start": 7.089166666666667,
  "end": 8.262041666666667
 },
 {
  "text": "Easy! Now make it ten million.",
  "start": 8.342041666666667,
  "end": 9.46325
 },
 {
  "text": "A hundred kilos. Heavier than you!",
  "start": 9.54325,
  "end": 10.880458333333333
 },
 {
  "text": "Stacked up, it's eleven meters tall.",
  "start": 10.960458333333333,
  "end": 12.2175
 },
 {
  "text": "Now... one hundred million dollars.",
  "start": 12.2975,
  "end": 13.565624999999999
 },
 {
  "text": "One full pallet. A whole ton.",
  "start": 13.645624999999999,
  "end": 14.775833333333333
 },
 {
  "text": "As heavy as a small car.",
  "start": 14.855833333333333,
  "end": 15.886708333333333
 },
 {
  "text": "Now... one billion dollars.",
  "start": 15.966708333333333,
  "end": 17.016541666666665
 },
 {
  "text": "Ten million bills. Ten tons.",
  "start": 17.096541666666667,
  "end": 18.391000000000002
 },
 {
  "text": "Heavier than an African elephant.",
  "start": 18.471,
  "end": 19.613375
 },
 {
  "text": "Stacked up? Over a kilometer tall.",
  "start": 19.693375,
  "end": 21.071916666666667
 },
 {
  "text": "It pokes right through the clouds.",
  "start": 21.151916666666665,
  "end": 22.260166666666663
 },
 {
  "text": "Taller than the world's tallest building!",
  "start": 22.340166666666665,
  "end": 23.63945833333333
 },
 {
  "text": "So... which pile could you carry home?",
  "start": 23.719458333333332,
  "end": 25.093999999999998
 }
]