[
 {
  "text": "What if a blue whale met a billion krill?",
  "start": 0.0,
  "end": 1.3345416666666667
 },
 {
  "text": "Meet one krill. About six centimeters long.",
  "start": 1.4145416666666668,
  "end": 3.2229583333333336
 },
 {
  "text": "It weighs roughly one single gram.",
  "start": 3.3029583333333337,
  "end": 4.538291666666667
 },
 {
  "text": "A thousand krill? About a kilogram.",
  "start": 4.618291666666667,
  "end": 6.218541666666667
 },
 {
  "text": "A million? A full ton, like a small car!",
  "start": 6.298541666666667,
  "end": 8.028125
 },
 {
  "text": "Now... one billion krill!",
  "start": 8.108125000000001,
  "end": 9.113708333333335
 },
 {
  "text": "About a thousand tons of tiny shrimp.",
  "start": 9.193708333333335,
  "end": 10.646041666666669
 },
 {
  "text": "As heavy as about seven blue whales!",
  "start": 10.726041666666669,
  "end": 12.076666666666668
 },
 {
  "text": "They'd fill twenty backyard pools.",
  "start": 12.15666666666667,
  "end": 13.353666666666669
 },
 {
  "text": "But here comes a hungry blue whale.",
  "start": 13.43366666666667,
  "end": 14.633375000000004
 },
 {
  "text": "One giant gulp of krill and water...",
  "start": 14.713375000000005,
  "end": 16.016125000000006
 },
 {
  "text": "about as heavy as its whole body!",
  "start": 16.216125000000005,
  "end": 17.383541666666673
 },
 {
  "text": "It can eat sixteen tons of krill a day.",
  "start": 17.46354166666667,
  "end": 18.76420833333334
 },
 {
  "text": "That's around sixteen million krill daily.",
  "start": 18.844208333333338,
  "end": 20.329916666666673
 },
 {
  "text": "So your billion krill army...",
  "start": 20.40991666666667,
  "end": 21.505541666666673
 },
 {
  "text": "is gone in about two months!",
  "start": 21.705541666666672,
  "end": 22.75920833333334
 },
 {
  "text": "Real krill swarms are even bigger.",
  "start": 22.83920833333334,
  "end": 24.14720833333334
 },
 {
  "text": "So... would you swim in the krill cloud?",
  "start": 24.22720833333334,
  "end": 25.67508333333334
 }
]