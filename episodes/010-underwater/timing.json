[
 {
  "text": "What if you stayed underwater too long?",
  "start": 0.0,
  "end": 1.2584583333333332
 },
 {
  "text": "Most people last thirty to ninety seconds.",
  "start": 1.3384583333333333,
  "end": 2.8897916666666665
 },
 {
  "text": "Here's what happens inside you.",
  "start": 2.9697916666666666,
  "end": 4.009458333333333
 },
 {
  "text": "First, cold water hits your face.",
  "start": 4.089458333333333,
  "end": 5.449458333333333
 },
 {
  "text": "Your heart instantly slows down.",
  "start": 5.529458333333333,
  "end": 6.834666666666667
 },
 {
  "text": "Blood rushes from your arms to your core.",
  "start": 6.914666666666667,
  "end": 8.388916666666667
 },
 {
  "text": "Your spleen squeezes out extra red cells.",
  "start": 8.468916666666667,
  "end": 9.98675
 },
 {
  "text": "But carbon dioxide keeps building up.",
  "start": 10.06675,
  "end": 11.419041666666667
 },
 {
  "text": "That's the burning urge to breathe!",
  "start": 11.499041666666667,
  "end": 12.651
 },
 {
  "text": "Your chest starts to twitch and jerk.",
  "start": 12.731,
  "end": 13.951833333333333
 },
 {
  "text": "Meanwhile, your oxygen keeps dropping.",
  "start": 14.031833333333333,
  "end": 15.470208333333334
 },
 {
  "text": "Your brain needs it the most.",
  "start": 15.550208333333334,
  "end": 16.626166666666666
 },
 {
  "text": "Push too far and you black out.",
  "start": 16.706166666666668,
  "end": 17.853583333333336
 },
 {
  "text": "Often with zero warning.",
  "start": 17.933583333333335,
  "end": 18.82691666666667
 },
 {
  "text": "Even when you feel totally fine.",
  "start": 18.906916666666667,
  "end": 20.101166666666668
 },
 {
  "text": "That's why you never swim alone!",
  "start": 20.181166666666666,
  "end": 21.306666666666665
 },
 {
  "text": "Top freedivers? About eleven minutes!",
  "start": 21.386666666666667,
  "end": 22.94275
 },
 {
  "text": "A Weddell seal? Over an hour!",
  "start": 23.02275,
  "end": 24.193458333333332
 },
 {
  "text": "So... how long can you last on dry land?",
  "start": 24.27345833333333,
  "end": 25.902416666666664
 }
]