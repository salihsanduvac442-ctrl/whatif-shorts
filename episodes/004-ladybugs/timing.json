[
 {
  "text": "What if one billion ladybugs landed on your house?",
  "start": 0.0,
  "end": 2.035875
 },
 {
  "text": "Start with one. About thirty milligrams.",
  "start": 2.115875,
  "end": 3.6997916666666666
 },
 {
  "text": "It eats around fifty aphids a day.",
  "start": 3.7797916666666667,
  "end": 5.051708333333333
 },
 {
  "text": "Now make it a thousand.",
  "start": 5.131708333333333,
  "end": 6.006375
 },
 {
  "text": "A tiny red cloud over the garden.",
  "start": 6.086374999999999,
  "end": 7.4442916666666665
 },
 {
  "text": "A million ladybugs? Thirty kilos of beetles.",
  "start": 7.524291666666667,
  "end": 9.489374999999999
 },
 {
  "text": "That's enough to cover your whole roof.",
  "start": 9.569375,
  "end": 10.801583333333333
 },
 {
  "text": "Now... one billion ladybugs.",
  "start": 10.881583333333335,
  "end": 12.157833333333336
 },
 {
  "text": "Thirty tons. Like a loaded cement truck.",
  "start": 12.237833333333334,
  "end": 13.891000000000002
 },
 {
  "text": "Spread out, they'd carpet five soccer fields.",
  "start": 13.971000000000002,
  "end": 15.646416666666669
 },
 {
  "text": "Or cover your house a hundred times over.",
  "start": 15.726416666666669,
  "end": 17.228083333333334
 },
 {
  "text": "Together they'd eat fifty billion aphids a day.",
  "start": 17.308083333333336,
  "end": 18.953583333333334
 },
 {
  "text": "Goodbye, garden pests!",
  "start": 19.033583333333336,
  "end": 19.955625
 },
 {
  "text": "Huge swarms are real.",
  "start": 20.035625000000003,
  "end": 20.93441666666667
 },
 {
  "text": "In twenty nineteen, one showed up on radar!",
  "start": 21.01441666666667,
  "end": 22.78229166666667
 },
 {
  "text": "Bother them, they ooze stinky yellow knee juice.",
  "start": 22.86229166666667,
  "end": 24.562666666666672
 },
 {
  "text": "In autumn, they crawl inside to sleep.",
  "start": 24.64266666666667,
  "end": 26.001750000000005
 },
 {
  "text": "So... would you let them move in?",
  "start": 26.081750000000003,
  "end": 27.213208333333338
 }
]