[
 {
  "text": "What if everyone on Earth got a million dollars?",
  "start": 0.0,
  "end": 1.6961666666666666
 },
 {
  "text": "Eight billion people. One million dollars each.",
  "start": 1.7761666666666667,
  "end": 3.6440833333333336
 },
 {
  "text": "That's eight quadrillion dollars!",
  "start": 3.7240833333333336,
  "end": 4.760541666666667
 },
 {
  "text": "In hundred-dollar bills? Eighty million tons.",
  "start": 4.840541666666667,
  "end": 6.782916666666667
 },
 {
  "text": "Heavier than twelve Great Pyramids!",
  "start": 6.862916666666667,
  "end": 8.081708333333333
 },
 {
  "text": "Stack them up? Past Pluto!",
  "start": 8.161708333333333,
  "end": 9.201666666666666
 },
 {
  "text": "Day one: you quit your job. Party!",
  "start": 9.281666666666666,
  "end": 10.699708333333334
 },
 {
  "text": "But so does everyone else.",
  "start": 10.779708333333334,
  "end": 11.857416666666667
 },
 {
  "text": "No farmers. No truckers. No bakers.",
  "start": 11.937416666666667,
  "end": 13.607958333333334
 },
 {
  "text": "But the shops have the same stuff as before.",
  "start": 13.687958333333334,
  "end": 15.186416666666668
 },
 {
  "text": "Just way more money chasing it.",
  "start": 15.266416666666668,
  "end": 16.406666666666666
 },
 {
  "text": "So prices explode!",
  "start": 16.486666666666668,
  "end": 17.372
 },
 {
  "text": "A single burger could cost thousands of dollars.",
  "start": 17.452,
  "end": 19.181708333333336
 },
 {
  "text": "Your million just melts away.",
  "start": 19.261708333333335,
  "end": 20.255375
 },
 {
  "text": "It's called hyperinflation.",
  "start": 20.335375000000003,
  "end": 21.286708333333337
 },
 {
  "text": "Zimbabwe once printed a hundred trillion dollar note!",
  "start": 21.366708333333335,
  "end": 23.24129166666667
 },
 {
  "text": "Money isn't wealth. Stuff is.",
  "start": 23.321291666666667,
  "end": 24.529583333333335
 },
 {
  "text": "So... what would you buy on day one?",
  "start": 24.609583333333333,
  "end": 25.884541666666667
 }
]