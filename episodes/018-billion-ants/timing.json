[
 {
  "text": "What if a billion ants tried to lift your house?",
  "start": 0.0,
  "end": 1.646375
 },
 {
  "text": "Start with one ant. About three milligrams.",
  "start": 1.726375,
  "end": 3.5088749999999997
 },
 {
  "text": "It can lift up to fifty times its weight!",
  "start": 3.588875,
  "end": 4.943833333333333
 },
 {
  "text": "Like you lifting two cars over your head!",
  "start": 5.023833333333333,
  "end": 6.449875
 },
 {
  "text": "The secret? Being tiny.",
  "start": 6.529875,
  "end": 7.498166666666666
 },
 {
  "text": "Small muscles are super strong for their size.",
  "start": 7.578166666666666,
  "end": 9.237916666666667
 },
 {
  "text": "A thousand ants can carry an apple.",
  "start": 9.317916666666667,
  "end": 10.632625
 },
 {
  "text": "A million ants? They lift a fridge!",
  "start": 10.712625000000001,
  "end": 12.087333333333333
 },
 {
  "text": "Now... one billion ants.",
  "start": 12.167333333333335,
  "end": 13.196416666666668
 },
 {
  "text": "That's three tons of ants!",
  "start": 13.27641666666667,
  "end": 14.270125000000004
 },
 {
  "text": "Together, they could lift about a hundred fifty tons.",
  "start": 14.350125000000002,
  "end": 16.368166666666667
 },
 {
  "text": "A typical house weighs around a hundred.",
  "start": 16.44816666666667,
  "end": 17.871333333333336
 },
 {
  "text": "On paper... your house lifts off!",
  "start": 17.951333333333334,
  "end": 19.301291666666668
 },
 {
  "text": "But here's the twist...",
  "start": 19.38129166666667,
  "end": 20.212958333333336
 },
 {
  "text": "Only about twenty thousand ants fit around the walls.",
  "start": 20.412958333333336,
  "end": 22.40129166666667
 },
 {
  "text": "The rest just stand there cheering!",
  "start": 22.48129166666667,
  "end": 23.61229166666667
 },
 {
  "text": "So... would you let a billion ants move your house?",
  "start": 23.69229166666667,
  "end": 25.575708333333335
 }
]