[
 {
  "text": "What if a billion dollars was rice?",
  "start": 0.0,
  "end": 1.2708333333333333
 },
 {
  "text": "Rice sells for about 500 dollars a ton.",
  "start": 1.3508333333333333,
  "end": 3.1196666666666664
 },
 {
  "text": "So a billion buys two million tons!",
  "start": 3.1996666666666664,
  "end": 4.611916666666667
 },
 {
  "text": "As cash? Just ten tons of bills.",
  "start": 4.691916666666667,
  "end": 6.081708333333333
 },
 {
  "text": "As rice? Two hundred thousand times heavier!",
  "start": 6.161708333333333,
  "end": 7.900041666666667
 },
 {
  "text": "That's about eighty trillion grains.",
  "start": 7.980041666666667,
  "end": 9.268125
 },
 {
  "text": "Count one per second? Two and a half million years!",
  "start": 9.348125,
  "end": 11.415458333333333
 },
 {
  "text": "Load it up. Eighty thousand trucks!",
  "start": 11.495458333333334,
  "end": 12.897666666666666
 },
 {
  "text": "Bumper to bumper? Over a thousand kilometers.",
  "start": 12.977666666666668,
  "end": 14.875250000000001
 },
 {
  "text": "Pour it into your backyard pool?",
  "start": 14.955250000000001,
  "end": 16.152250000000002
 },
 {
  "text": "You'd fill about a thousand Olympic pools!",
  "start": 16.23225,
  "end": 17.783375
 },
 {
  "text": "Dump it in one pile?",
  "start": 17.863375,
  "end": 18.673750000000002
 },
 {
  "text": "A rice mountain thirty stories tall!",
  "start": 18.75375,
  "end": 20.093458333333334
 },
 {
  "text": "Sounds endless? Not really.",
  "start": 20.173458333333333,
  "end": 21.389416666666666
 },
 {
  "text": "The whole world eats that in under two days.",
  "start": 21.469416666666667,
  "end": 23.03741666666667
 },
 {
  "text": "Over half of humanity lives on rice.",
  "start": 23.117416666666667,
  "end": 24.702708333333334
 },
 {
  "text": "So... would you take the cash or the rice?",
  "start": 24.782708333333336,
  "end": 26.349583333333335
 }
]