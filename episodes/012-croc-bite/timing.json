[
 {
  "text": "What if you had the bite of a crocodile?",
  "start": 0.0,
  "end": 1.3884583333333333
 },
 {
  "text": "Meet the saltwater crocodile. Up to six meters long.",
  "start": 1.4684583333333334,
  "end": 3.6117083333333335
 },
 {
  "text": "It has the strongest bite ever measured.",
  "start": 3.6917083333333336,
  "end": 4.982291666666667
 },
 {
  "text": "About 16,000 newtons. Snap!",
  "start": 5.062291666666667,
  "end": 6.618125
 },
 {
  "text": "That's like a car pressing down.",
  "start": 6.698125,
  "end": 7.845208333333334
 },
 {
  "text": "Your bite? Roughly 1,000 newtons.",
  "start": 7.925208333333334,
  "end": 9.478083333333334
 },
 {
  "text": "Sixteen times weaker.",
  "start": 9.558083333333334,
  "end": 10.474083333333335
 },
 {
  "text": "But the muscles that open its jaws are weak.",
  "start": 10.554083333333335,
  "end": 12.295625000000001
 },
 {
  "text": "A few wraps of tape can hold them shut!",
  "start": 12.375625000000001,
  "end": 13.683625000000001
 },
 {
  "text": "Its jaws feel touch better than your fingertips.",
  "start": 13.763625000000001,
  "end": 15.452458333333334
 },
 {
  "text": "And each tooth can be replaced about 50 times.",
  "start": 15.532458333333334,
  "end": 17.37291666666667
 },
 {
  "text": "It even swallows stones, maybe to help it dive.",
  "start": 17.452916666666667,
  "end": 19.47375
 },
 {
  "text": "Now you. A normal bite? Crunch, an apple.",
  "start": 19.55375,
  "end": 21.24275
 },
 {
  "text": "Now switch on crocodile power!",
  "start": 21.32275,
  "end": 22.487708333333334
 },
 {
  "text": "A coconut? Crushed in one bite!",
  "start": 22.567708333333332,
  "end": 23.6695
 },
 {
  "text": "A brick? Snapped in half!",
  "start": 23.749499999999998,
  "end": 24.707791666666665
 },
 {
  "text": "Just watch out for your tongue.",
  "start": 24.787791666666664,
  "end": 25.865916666666664
 },
 {
  "text": "So... what would you bite first?",
  "start": 25.945916666666662,
  "end": 27.082874999999994
 }
]