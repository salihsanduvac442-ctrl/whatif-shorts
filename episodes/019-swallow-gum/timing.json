[
 {
  "text": "What if you swallowed your chewing gum?",
  "start": 0.0,
  "end": 1.206375
 },
 {
  "text": "Gulp! Down it goes.",
  "start": 1.286375,
  "end": 2.101166666666667
 },
 {
  "text": "The myth: it stays inside for seven years!",
  "start": 2.181166666666667,
  "end": 3.9552916666666667
 },
 {
  "text": "The truth? Not even close.",
  "start": 4.035291666666667,
  "end": 5.176041666666666
 },
 {
  "text": "First stop: your stomach.",
  "start": 5.2560416666666665,
  "end": 6.167833333333333
 },
 {
  "text": "Stomach acid attacks... and fails!",
  "start": 6.247833333333333,
  "end": 7.745
 },
 {
  "text": "The sugar and flavor? Absorbed.",
  "start": 7.825,
  "end": 9.18575
 },
 {
  "text": "But the rubbery gum base can't be digested.",
  "start": 9.26575,
  "end": 10.997416666666668
 },
 {
  "text": "Real food melts away. The gum stays whole.",
  "start": 11.077416666666668,
  "end": 12.969291666666669
 },
 {
  "text": "So it just keeps moving.",
  "start": 13.049291666666669,
  "end": 13.920916666666669
 },
 {
  "text": "Your gut squeezes it along.",
  "start": 14.000916666666669,
  "end": 14.969625000000002
 },
 {
  "text": "Through meters and meters of twisty gut.",
  "start": 15.049625000000002,
  "end": 16.531625000000002
 },
 {
  "text": "A few days later... it's out!",
  "start": 16.611625000000004,
  "end": 17.677625000000003
 },
 {
  "text": "Not seven years. Just a few days!",
  "start": 17.757625000000004,
  "end": 19.170125000000006
 },
 {
  "text": "The real danger? Swallowing a LOT.",
  "start": 19.250125000000004,
  "end": 20.76554166666667
 },
 {
  "text": "Doctors have found big gum lumps blocking kids' guts.",
  "start": 20.84554166666667,
  "end": 22.867833333333337
 },
 {
  "text": "One piece now and then? No problem.",
  "start": 22.947833333333335,
  "end": 24.423708333333334
 },
 {
  "text": "So... have YOU ever swallowed gum?",
  "start": 24.503708333333336,
  "end": 25.747208333333337
 }
]