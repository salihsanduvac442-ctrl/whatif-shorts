[
 {
  "text": "What if your heart stopped for ten minutes?",
  "start": 0.0,
  "end": 1.3507083333333334
 },
 {
  "text": "It beats about a hundred thousand times a day.",
  "start": 1.4307083333333335,
  "end": 3.0780416666666666
 },
 {
  "text": "Then suddenly... it stops.",
  "start": 3.1580416666666666,
  "end": 4.275541666666666
 },
 {
  "text": "Often it just quivers, out of rhythm.",
  "start": 4.355541666666666,
  "end": 5.710666666666667
 },
 {
  "text": "Blood stops flowing. No more oxygen!",
  "start": 5.790666666666667,
  "end": 7.4470833333333335
 },
 {
  "text": "Your brain uses twenty percent of it.",
  "start": 7.527083333333334,
  "end": 8.925916666666668
 },
 {
  "text": "About ten seconds: you pass out.",
  "start": 9.005916666666668,
  "end": 10.260208333333335
 },
 {
  "text": "No pulse. No normal breathing.",
  "start": 10.340208333333335,
  "end": 11.714333333333334
 },
 {
  "text": "After four minutes, brain cells start dying.",
  "start": 11.794333333333334,
  "end": 13.493791666666667
 },
 {
  "text": "Every minute without help, survival drops up to ten percent.",
  "start": 13.573791666666668,
  "end": 15.829208333333336
 },
 {
  "text": "But someone starts CPR!",
  "start": 15.909208333333336,
  "end": 17.04404166666667
 },
 {
  "text": "Push hard and fast. Two pushes a second!",
  "start": 17.12404166666667,
  "end": 18.79904166666667
 },
 {
  "text": "Each push squeezes blood to your brain.",
  "start": 18.87904166666667,
  "end": 20.239625000000004
 },
 {
  "text": "Then an AED zaps your chest.",
  "start": 20.319625000000002,
  "end": 21.57625
 },
 {
  "text": "The quivering stops. The rhythm resets!",
  "start": 21.656250000000004,
  "end": 23.19129166666667
 },
 {
  "text": "With fast CPR, some survive even ten minutes.",
  "start": 23.27129166666667,
  "end": 25.465500000000002
 },
 {
  "text": "So... would you know how to do CPR?",
  "start": 25.545500000000004,
  "end": 27.047750000000004
 }
]