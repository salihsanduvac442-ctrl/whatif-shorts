[
 {
  "text": "What if you laid a billion dollars end to end?",
  "start": 0.0,
  "end": 1.598625
 },
 {
  "text": "Start with one single dollar bill.",
  "start": 1.678625,
  "end": 2.935375
 },
 {
  "text": "It's about 15 and a half centimeters long.",
  "start": 3.015375,
  "end": 4.5289166666666665
 },
 {
  "text": "Ten bills? About as long as you.",
  "start": 4.6089166666666666,
  "end": 5.7965
 },
 {
  "text": "A thousand bills? 156 meters.",
  "start": 5.8765,
  "end": 7.924125
 },
 {
  "text": "A million? 156 kilometers!",
  "start": 8.004125,
  "end": 9.742708333333333
 },
 {
  "text": "That's almost four marathons.",
  "start": 9.822708333333333,
  "end": 11.010791666666666
 },
 {
  "text": "Now... a billion dollar bills.",
  "start": 11.090791666666666,
  "end": 12.332208333333332
 },
 {
  "text": "156 thousand kilometers of cash!",
  "start": 12.412208333333332,
  "end": 14.306874999999998
 },
 {
  "text": "It wraps around the whole Earth...",
  "start": 14.386875,
  "end": 15.515
 },
 {
  "text": "almost four times!",
  "start": 15.715,
  "end": 16.585791666666665
 },
 {
  "text": "Or aim it at the Moon...",
  "start": 16.665791666666667,
  "end": 17.537875
 },
 {
  "text": "It gets about 40 percent of the way.",
  "start": 17.737875,
  "end": 19.128166666666665
 },
 {
  "text": "Walking it nonstop, no sleep...",
  "start": 19.208166666666667,
  "end": 20.507375
 },
 {
  "text": "takes about three and a half years.",
  "start": 20.707375,
  "end": 21.918083333333332
 },
 {
  "text": "Laying one bill every second?",
  "start": 21.998083333333334,
  "end": 23.106666666666666
 },
 {
  "text": "Over 31 years. Your hair turns gray!",
  "start": 23.186666666666667,
  "end": 25.059291666666667
 },
 {
  "text": "So... how far would you walk it?",
  "start": 25.13929166666667,
  "end": 26.270083333333336
 }
]