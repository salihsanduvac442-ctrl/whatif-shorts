[
 {
  "text": "What if you could change color like an octopus?",
  "start": 0.0,
  "end": 1.6845833333333333
 },
 {
  "text": "Meet the octopus. Master of disguise.",
  "start": 1.7645833333333334,
  "end": 3.52025
 },
 {
  "text": "Its skin has thousands of tiny color sacs.",
  "start": 3.60025,
  "end": 5.2865416666666665
 },
 {
  "text": "Red, yellow, brown, black. Like paint bags.",
  "start": 5.3665416666666665,
  "end": 7.13425
 },
 {
  "text": "Tiny muscles stretch them open. Color appears!",
  "start": 7.21425,
  "end": 9.190083333333334
 },
 {
  "text": "Its brain does it in a split second.",
  "start": 9.270083333333332,
  "end": 10.507833333333332
 },
 {
  "text": "It can grow bumps and spikes, too.",
  "start": 10.587833333333332,
  "end": 11.836916666666665
 },
 {
  "text": "Sand? Coral? Rock? It becomes them all.",
  "start": 11.916916666666665,
  "end": 13.579458333333331
 },
 {
  "text": "Angry octopuses can turn dark.",
  "start": 13.659458333333331,
  "end": 14.885499999999999
 },
 {
  "text": "The weird part? It's probably colorblind!",
  "start": 14.965499999999999,
  "end": 16.596375
 },
 {
  "text": "Its skin may even sense light itself.",
  "start": 16.676375,
  "end": 18.122458333333334
 },
 {
  "text": "Normal you on the lawn? Easy to spot.",
  "start": 18.202458333333333,
  "end": 19.708916666666667
 },
 {
  "text": "Now switch on octopus power!",
  "start": 19.788916666666665,
  "end": 20.974916666666665
 },
 {
  "text": "Striped grass? Now you're striped too.",
  "start": 21.054916666666664,
  "end": 22.363916666666665
 },
 {
  "text": "Lean on the house? You become the wall.",
  "start": 22.443916666666663,
  "end": 23.87795833333333
 },
 {
  "text": "Hide and seek? Undefeated forever.",
  "start": 23.95795833333333,
  "end": 25.427374999999998
 },
 {
  "text": "So... where would you hide first?",
  "start": 25.507374999999996,
  "end": 26.69433333333333
 }
]