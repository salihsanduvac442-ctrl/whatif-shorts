[
 {
  "text": "What if you never slept again?",
  "start": 0.0,
  "end": 1.0449166666666667
 },
 {
  "text": "Meet you... and your well-rested twin.",
  "start": 1.1249166666666668,
  "end": 2.4545000000000003
 },
 {
  "text": "Hour twenty: nonstop yawning.",
  "start": 2.5345000000000004,
  "end": 3.8494166666666674
 },
 {
  "text": "Hour twenty-four: your brain acts drunk.",
  "start": 3.9294166666666674,
  "end": 5.586333333333334
 },
 {
  "text": "Your twin catches the ball. You don't!",
  "start": 5.666333333333334,
  "end": 6.990541666666667
 },
 {
  "text": "Day two: microsleeps begin.",
  "start": 7.070541666666667,
  "end": 8.251125
 },
 {
  "text": "Your brain naps for seconds, eyes open!",
  "start": 8.331125,
  "end": 9.867666666666667
 },
 {
  "text": "Day three: you may start seeing things.",
  "start": 9.947666666666667,
  "end": 11.331125
 },
 {
  "text": "Hedges wiggle. Shadows walk around.",
  "start": 11.411125,
  "end": 12.955625
 },
 {
  "text": "Why? Sleep is your brain's cleaning shift.",
  "start": 13.035625,
  "end": 14.472541666666666
 },
 {
  "text": "Fluid washes the waste out while you sleep.",
  "start": 14.552541666666666,
  "end": 16.129666666666665
 },
 {
  "text": "Skip it, and the trash piles up.",
  "start": 16.209666666666667,
  "end": 17.42125
 },
 {
  "text": "The record? Eleven days, in 1964.",
  "start": 17.50125,
  "end": 19.648666666666664
 },
 {
  "text": "Now record books won't allow tries. Too risky.",
  "start": 19.728666666666665,
  "end": 21.692
 },
 {
  "text": "Lab rats kept awake died within weeks.",
  "start": 21.772,
  "end": 23.355874999999997
 },
 {
  "text": "But here's the twist...",
  "start": 23.435875,
  "end": 24.267541666666666
 },
 {
  "text": "Your brain will force you to sleep anyway!",
  "start": 24.467541666666666,
  "end": 25.93525
 },
 {
  "text": "So... how long have YOU stayed awake?",
  "start": 26.015249999999998,
  "end": 27.343374999999998
 }
]