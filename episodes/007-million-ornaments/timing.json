[
 {
  "text": "What if one tree held a million ornaments?",
  "start": 0.0,
  "end": 1.436875
 },
 {
  "text": "A normal tree holds about a hundred.",
  "start": 1.516875,
  "end": 2.848583333333333
 },
 {
  "text": "Each glass ball weighs around 25 grams.",
  "start": 2.928583333333333,
  "end": 4.771875
 },
 {
  "text": "A thousand ornaments? The branches sag.",
  "start": 4.851875,
  "end": 6.452916666666667
 },
 {
  "text": "Ten thousand? A quarter of a tonne.",
  "start": 6.532916666666667,
  "end": 7.865916666666667
 },
 {
  "text": "Heavier than three grown adults.",
  "start": 7.945916666666667,
  "end": 9.064166666666667
 },
 {
  "text": "Snap! The trunk gives up.",
  "start": 9.144166666666667,
  "end": 10.0555
 },
 {
  "text": "A million ornaments weigh about 25 tonnes.",
  "start": 10.1355,
  "end": 12.027458333333334
 },
 {
  "text": "That's roughly four big elephants of glass.",
  "start": 12.107458333333334,
  "end": 13.677458333333334
 },
 {
  "text": "Piled up, they'd nearly fill a house.",
  "start": 13.757458333333334,
  "end": 15.060083333333335
 },
 {
  "text": "To hang them all, you'd need a giant tree.",
  "start": 15.140083333333333,
  "end": 16.698375
 },
 {
  "text": "About 190 meters tall!",
  "start": 16.778375,
  "end": 18.071791666666666
 },
 {
  "text": "Taller than any real tree on Earth.",
  "start": 18.151791666666668,
  "end": 19.482958333333336
 },
 {
  "text": "The record holder is about 116 meters.",
  "start": 19.562958333333334,
  "end": 21.72341666666667
 },
 {
  "text": "Hang one every five seconds, nonstop...",
  "start": 21.803416666666667,
  "end": 23.299541666666666
 },
 {
  "text": "That takes about 58 days. No sleep.",
  "start": 23.499541666666666,
  "end": 25.290666666666667
 },
 {
  "text": "And one little bump? Crash!",
  "start": 25.370666666666665,
  "end": 26.497625
 },
 {
  "text": "So... how many would you hang?",
  "start": 26.577624999999998,
  "end": 27.622541666666663
 }
]