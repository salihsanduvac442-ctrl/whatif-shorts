[
 {
  "text": "What if you tried to hang a million ornaments?",
  "start": 0.0,
  "end": 1.6067083333333334
 },
 {
  "text": "Problem one: finding the tree.",
  "start": 1.6867083333333335,
  "end": 2.8638333333333335
 },
 {
  "text": "A normal tree holds about a hundred.",
  "start": 2.9438333333333335,
  "end": 4.275541666666667
 },
 {
  "text": "A million needs one 190 meters tall.",
  "start": 4.355541666666667,
  "end": 6.359791666666667
 },
 {
  "text": "No tree on Earth is that big.",
  "start": 6.439791666666667,
  "end": 7.5399166666666675
 },
 {
  "text": "The record is about 116 meters.",
  "start": 7.619916666666668,
  "end": 9.522291666666668
 },
 {
  "text": "Fine, use a normal tree. Problem two!",
  "start": 9.602291666666668,
  "end": 11.271791666666667
 },
 {
  "text": "Each glass ball weighs about 25 grams.",
  "start": 11.351791666666667,
  "end": 13.122333333333334
 },
 {
  "text": "Ten thousand? The branches sag... Snap!",
  "start": 13.202333333333334,
  "end": 14.804541666666667
 },
 {
  "text": "A million weigh about 25 tonnes.",
  "start": 14.884541666666667,
  "end": 16.378666666666668
 },
 {
  "text": "That's four elephants of glass.",
  "start": 16.458666666666666,
  "end": 17.616875
 },
 {
  "text": "Piled up, they'd nearly fill a house.",
  "start": 17.696875,
  "end": 18.999499999999998
 },
 {
  "text": "Problem three: time.",
  "start": 19.0795,
  "end": 19.943833333333334
 },
 {
  "text": "Hang one every five seconds, nonstop...",
  "start": 20.023833333333332,
  "end": 21.51995833333333
 },
 {
  "text": "That's about 58 days. No sleep.",
  "start": 21.71995833333333,
  "end": 23.33075
 },
 {
  "text": "Start today, finish December 29th.",
  "start": 23.410749999999997,
  "end": 24.953916666666665
 },
 {
  "text": "Christmas? Already over.",
  "start": 25.033916666666663,
  "end": 26.049749999999996
 },
 {
  "text": "So... would you even try?",
  "start": 26.129749999999998,
  "end": 27.168291666666665
 }
]