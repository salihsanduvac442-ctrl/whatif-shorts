[
 {
  "text": "What if a box jellyfish stung you?",
  "start": 0.0,
  "end": 1.207375
 },
 {
  "text": "Meet the box jellyfish. Almost invisible.",
  "start": 1.2873750000000002,
  "end": 3.0536666666666665
 },
 {
  "text": "It has 24 eyes... but no brain!",
  "start": 3.1336666666666666,
  "end": 4.856791666666666
 },
 {
  "text": "Up to 60 tentacles, each up to 3 meters long.",
  "start": 4.936791666666666,
  "end": 7.061416666666666
 },
 {
  "text": "Covered in millions of tiny harpoons.",
  "start": 7.141416666666666,
  "end": 8.617458333333333
 },
 {
  "text": "Brush against one... and they fire!",
  "start": 8.697458333333334,
  "end": 10.039666666666667
 },
 {
  "text": "Faster than almost anything in nature.",
  "start": 10.119666666666667,
  "end": 11.527458333333334
 },
 {
  "text": "Venom shoots into your skin.",
  "start": 11.607458333333334,
  "end": 12.63
 },
 {
  "text": "The pain? Among the worst on Earth.",
  "start": 12.71,
  "end": 14.086333333333334
 },
 {
  "text": "A big sting can stop a heart in minutes.",
  "start": 14.166333333333334,
  "end": 15.561583333333335
 },
 {
  "text": "But most stings are not deadly.",
  "start": 15.641583333333335,
  "end": 16.815333333333335
 },
 {
  "text": "Step one: get out and call for help.",
  "start": 16.895333333333333,
  "end": 18.252041666666667
 },
 {
  "text": "Then pour on vinegar. Lots of it!",
  "start": 18.332041666666665,
  "end": 19.587291666666665
 },
 {
  "text": "It stops the unfired harpoons.",
  "start": 19.667291666666664,
  "end": 20.99408333333333
 },
 {
  "text": "Never rub it. Skip the fresh water.",
  "start": 21.07408333333333,
  "end": 22.463791666666665
 },
 {
  "text": "Doctors even have an antivenom.",
  "start": 22.543791666666664,
  "end": 23.79495833333333
 },
 {
  "text": "That's why swimmers wear stinger suits.",
  "start": 23.874958333333332,
  "end": 25.21108333333333
 },
 {
  "text": "So... would you swim there?",
  "start": 25.291083333333333,
  "end": 26.233208333333334
 }
]