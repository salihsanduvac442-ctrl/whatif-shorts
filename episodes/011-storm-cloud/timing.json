[
 {
  "text": "What if a storm cloud sucked you up?",
  "start": 0.0,
  "end": 1.1830833333333333
 },
 {
  "text": "In 2007, it really happened to a paraglider.",
  "start": 1.2630833333333333,
  "end": 3.56025
 },
 {
  "text": "Over Australia, a thunderstorm grabbed her wing.",
  "start": 3.64025,
  "end": 5.561833333333333
 },
 {
  "text": "Updrafts yanked her up like an elevator.",
  "start": 5.6418333333333335,
  "end": 7.183458333333333
 },
 {
  "text": "Inside the cloud, everything went dark.",
  "start": 7.263458333333333,
  "end": 8.8455
 },
 {
  "text": "Hailstones started hammering her.",
  "start": 8.9255,
  "end": 10.012958333333334
 },
 {
  "text": "Lightning flashed all around her.",
  "start": 10.092958333333334,
  "end": 11.1895
 },
 {
  "text": "The air dropped to minus fifty degrees.",
  "start": 11.2695,
  "end": 12.796333333333333
 },
 {
  "text": "Too little oxygen... she blacked out.",
  "start": 12.876333333333335,
  "end": 14.340250000000001
 },
 {
  "text": "Higher than Mount Everest!",
  "start": 14.420250000000001,
  "end": 15.349250000000001
 },
 {
  "text": "Almost ten thousand meters up.",
  "start": 15.429250000000001,
  "end": 16.508000000000003
 },
 {
  "text": "Her GPS recorded the whole climb.",
  "start": 16.588,
  "end": 18.244458333333334
 },
 {
  "text": "As high as a passenger jet!",
  "start": 18.324458333333336,
  "end": 19.426625
 },
 {
  "text": "Ice covered her from head to toe.",
  "start": 19.506625000000003,
  "end": 20.718333333333337
 },
 {
  "text": "Then the storm finally let her drop.",
  "start": 20.798333333333336,
  "end": 22.162333333333336
 },
 {
  "text": "She woke up and steered back down.",
  "start": 22.242333333333335,
  "end": 23.455458333333336
 },
 {
  "text": "She landed hours later, frozen... but alive!",
  "start": 23.535458333333334,
  "end": 25.454333333333334
 },
 {
  "text": "So... would you ever fly near a storm?",
  "start": 25.534333333333336,
  "end": 26.924583333333338
 }
]